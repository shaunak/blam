# Server-only Cloudflare TURN key. Never use a VITE_ prefix for these values.
CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=
# Public rooms use TURN by default when it is configured. Set 0 to allow direct paths.
# FORCE_RELAY=0
# Public signaling is separate from TURN.
# SIGNAL_URL=wss://play.example.com/signal
